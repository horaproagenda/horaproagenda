# Copie para /opt/evolution/.env (mesmo diretório do docker-compose.yml)
#
# 1) Gere a chave no servidor:  openssl rand -hex 32
# 2) Cole o resultado em AUTHENTICATION_API_KEY (o MESMO valor vai no secret
#    EVOLUTION_API_KEY do aplicativo).

AUTHENTICATION_API_KEY=COLE_AQUI_O_RESULTADO_DO_OPENSSL

# Domínio público do seu servidor Evolution (precisa ter HTTPS válido).
SERVER_URL=https://evo.horaproagenda.app

# Webhook do Hora Pro (edge function whatsapp-webhook) — já é o valor correto
# do seu projeto Supabase.
WEBHOOK_GLOBAL_URL=https://nsgcllrbswodjoadybsj.supabase.co/functions/v1/whatsapp-webhook

# Senha do Postgres interno (troque por algo forte; gere com: openssl rand -hex 24)
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_FORTE

# Versão do WhatsApp Web (Baileys). Se a sessão conectar e cair após alguns
# minutos, atualize este valor para a versão atual do WhatsApp Web.
CONFIG_SESSION_PHONE_VERSION=2.3000.1027934701
